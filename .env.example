# ==============================================================================
# TIREXXZ SCRENNER - SYSTEM ENVIRONMENT CONFIGURATION (TEMPLATE)
# Salin file ini menjadi .env pada server VPS: cp .env.example .env
# ==============================================================================

# Ganti dengan secret key unik Anda (bisa digenerate via: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change_this_to_a_secure_random_string_on_vps

# Kredensial Login Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password_on_vps

# Durasi Sesi (dalam hari)
SESSION_LIFETIME_DAYS=7
REMEMBER_ME_DAYS=30
