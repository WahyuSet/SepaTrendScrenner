render_header() =>
    table.cell(scr_table, 0, 0, "MINERVINI SEPA SCREENER (STAGE 2 WATCHLIST)", bgcolor=color.new(#111827, 0), text_color=color.white, text_size=size.small)
    table.merge_cells(scr_table, 0, 0, 6, 0)
    
    table.cell(scr_table, 0, 1, "Ticker", bgcolor=color.new(#1F2937, 0), text_color=#9CA3AF, text_size=size.small)
    table.cell(scr_table, 1, 1, "Price", bgcolor=color.new(#1F2937, 0), text_color=#9CA3AF, text_size=size.small)
    table.cell(scr_table, 2, 1, "SEPA Score", bgcolor=color.new(#1F2937, 0), text_color=#9CA3AF, text_size=size.small)
    table.cell(scr_table, 3, 1, "Stage 2 Status", bgcolor=color.new(#1F2937, 0), text_color=#9CA3AF, text_size=size.small)
    table.cell(scr_table, 4, 1, "52W Low", bgcolor=color.new(#1F2937, 0), text_color=#9CA3AF, text_size=size.small)
    table.cell(scr_table, 5, 1, "52W High", bgcolor=color.new(#1F2937, 0), text_color=#9CA3AF, text_size=size.small)
    table.cell(scr_table, 6, 1, "RS Score", bgcolor=color.new(#1F2937, 0), text_color=#9CA3AF, text_size=size.small)

render_row(r, sym, c, d_low, d_high, rs_score, tot_score, is_stage2, has_data) =>
    if sym != ""
        clean_sym = str.replace_all(sym, ".*:", "")
        if not has_data
            table.cell(scr_table, 0, r, clean_sym, bgcolor=color.new(#1F2937, 20), text_color=color.white, text_size=size.small)
            table.cell(scr_table, 1, r, "Data < 252D", bgcolor=color.new(#DC2626, 20), text_color=#FCA5A5, text_size=size.small)
            table.merge_cells(scr_table, 1, r, 6, r)
        else
            color bg = is_stage2 ? color.new(#059669, 30) : (tot_score >= 6 ? color.new(#D97706, 30) : color.new(#1F2937, 20))
            color status_color = is_stage2 ? #34D399 : (tot_score >= 6 ? #FBBF24 : #F87171)
            string status_text = is_stage2 ? "CONFIRMED" : (tot_score >= 6 ? "WATCHLIST" : "UNQUALIFIED")
            
            table.cell(scr_table, 0, r, clean_sym, bgcolor=bg, text_color=color.white, text_size=size.small)
            table.cell(scr_table, 1, r, str.tostring(c, "#.##"), bgcolor=bg, text_color=color.white, text_size=size.small)
            table.cell(scr_table, 2, r, str.tostring(tot_score) + " / 8", bgcolor=bg, text_color=status_color, text_size=size.small)
            table.cell(scr_table, 3, r, status_text, bgcolor=bg, text_color=status_color, text_size=size.small)
            table.cell(scr_table, 4, r, "+" + str.tostring(d_low, "#.#") + "%", bgcolor=bg, text_color=d_low >= pct_above_low ? #34D399 : #F87171, text_size=size.small)
            table.cell(scr_table, 5, r, "-" + str.tostring(d_high, "#.#") + "%", bgcolor=bg, text_color=d_high <= pct_within_high ? #34D399 : #F87171, text_size=size.small)
            table.cell(scr_table, 6, r, str.tostring(rs_score, "0") + "/100", bgcolor=bg, text_color=rs_score >= rs_threshold ? #34D399 : #9CA3AF, text_size=size.small)

