pct_within_high  = input.float(25.0, "Max % Dist from 52W High", group=grp_params)
len_slope_min    = input.int(22, "MA 200 Min Slope Days (≈1 Bulan)", group=grp_params)
len_slope_ideal  = input.int(88, "MA 200 Ideal Slope Days (≈4-5 Bulan)", group=grp_params)
rs_threshold     = input.float(70.0, "RS Rating Threshold (0-100)", group=grp_params)

// ==============================================================================
// 2. CALCULATION ENGINE (COMPUTED DIRECTLY ON NATIVE RESOLUTION)
// ==============================================================================
f_calc() =>
    has_data = not na(close[len_52w]) and bar_index >= len_52w
    
    m50  = ta.sma(close, 50)
    m150 = ta.sma(close, 150)
    m200 = ta.sma(close, 200)
    
    m200_min   = m200 > m200[len_slope_min]
    m200_ideal = m200 > m200[len_slope_ideal]
    m200_up    = m200_ideal or m200_min
    
    h52 = ta.highest(high, len_52w)
    l52 = ta.lowest(low, len_52w)
    
    dist_low  = l52 != 0 ? ((close - l52) / l52) * 100.0 : 0.0
    dist_high = h52 != 0 ? ((h52 - close) / h52) * 100.0 : 0.0
    
    c1 = has_data and (close > m150) and (close > m200)
    c2 = has_data and (m150 > m200)
    c3 = has_data and m200_up
    c4 = has_data and (m50 > m150) and (m50 > m200)
    c5 = has_data and (close > m50)
    c6 = has_data and (dist_low >= pct_above_low)
    c7 = has_data and (dist_high <= pct_within_high)
    
    r_3m  = not na(close[63])  and close[63]  != 0 ? (close - close[63])  / close[63]  : 0.0
    r_6m  = not na(close[126]) and close[126] != 0 ? (close - close[126]) / close[126] : 0.0
    r_9m  = not na(close[189]) and close[189] != 0 ? (close - close[189]) / close[189] : 0.0
    r_12m = not na(close[252]) and close[252] != 0 ? (close - close[252]) / close[252] : 0.0
    s_perf = 0.40 * r_3m + 0.20 * r_6m + 0.20 * r_9m + 0.20 * r_12m
    
    base_score = (c1 ? 1 : 0) + (c2 ? 1 : 0) + (c3 ? 1 : 0) + (c4 ? 1 : 0) + (c5 ? 1 : 0) + (c6 ? 1 : 0) + (c7 ? 1 : 0)
    
    [close, dist_low, dist_high, base_score, s_perf, has_data ? 1.0 : 0.0]

// Benchmark Data
[b_close, b_dlow, b_dhigh, b_base, b_perf, b_has] = request.security(benchmark_sym != "" ? benchmark_sym : "IDX:COMPOSITE", "D", f_calc(), barmerge.gaps_off, barmerge.lookahead_off)

// Security Fetcher per Symbol
get_stock(sym) =>
    s = sym != "" ? sym : syminfo.tickerid
    [c, dl, dh, sc, perf, has_flt] = request.security(s, "D", f_calc(), barmerge.gaps_off, barmerge.lookahead_off)
    has_dt = has_flt > 0.5
    rs_diff = (perf - b_perf) * 100.0
    rs_sc = math.max(1.0, math.min(99.0, 50.0 + (rs_diff * 1.5)))
    c8 = has_dt and (rs_sc >= rs_threshold or perf > b_perf)
    tot_sc = sc + (c8 ? 1 : 0)
    is_st2 = has_dt and (tot_sc == 8)
    [c, dl, dh, rs_sc, tot_sc, is_st2, has_dt]

// Global evaluations
